{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prisma:generate": "prisma generate --config ./prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ./prisma.config.ts && prisma generate --config ./prisma.config.ts",
    "prisma:seed": "prisma db seed --config ./prisma.config.ts",
    "prisma:studio": "prisma studio --config ./prisma.config.ts",
    "server:start": "bash scripts/server.sh start",
    "server:stop": "bash scripts/server.sh stop",
    "server:restart": "bash scripts/server.sh restart",
    "server:rebuild": "bash scripts/server.sh rebuild",
    "server:status": "bash scripts/server.sh status"
  },
  "dependencies": {
    "@nuxt/ui": "^3.3.3",
    "@prisma/adapter-mariadb": "7.2.0",
    "@prisma/client": "7.2.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "mariadb": "3.4.5",
    "nuxt": "^4.2.2",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "prisma": "7.2.0"
  }
}
