DATABASE_NAME="app_db"
DATABASE_USER="promo"
DATABASE_PASS="password"
DATABASE_PORT=3306

# Prisma ORM v7 uses prisma.config.ts for Migrate connection URLs.
DATABASE_URL="mysql://promo:password@127.0.0.1:3306/app_db"
SHADOW_DATABASE_URL="mysql://promo:password@127.0.0.1:3306/app_db_shadow"

# Admin seed (created only if AdminUser table is empty)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Used to sign admin session cookie (JWT)
AUTH_SECRET="change_me_to_a_long_random_string"
